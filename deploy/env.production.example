# Production settings for deploy/docker-compose.prod.yml.
#   cp deploy/env.production.example deploy/.env    (deploy/.env is git-ignored; keep it mode 600)
# Compose reads this file to fill in deploy/docker-compose.prod.yml and passes every line to api, worker
# and beat. The compose file itself fixes ENV=production, DATABASE_URL, REDIS_URL, TASK_ALWAYS_EAGER=false,
# RATE_LIMIT_BACKEND=redis, STORAGE_BACKEND=s3, EMAIL_BACKEND=smtp, COOKIE_SECURE=true, TRUSTED_PROXIES=1.
# All other settings and their defaults: .env.example.
#
# Generate values (URL-safe, so they can go into connection URLs):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                   # passwords, tokens
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # ENCRYPTION_KEYS
# Store a copy of SECRET_KEY, ENCRYPTION_KEYS and the database password in your password manager / secret
# store: without ENCRYPTION_KEYS, backups of files and encrypted columns cannot be read.

# ---- site / TLS (Caddy) ----
DOMAIN=resumes.example.com           # DNS A/AAAA record must point at this host; ports 80 and 443 open
ACME_EMAIL=ops@example.com           # Let's Encrypt account / expiry notices
PUBLIC_BASE_URL=https://resumes.example.com
API_BASE_URL=https://resumes.example.com
CORS_ORIGINS=https://resumes.example.com
# HTTP_PORT=80                       # host ports Caddy listens on
# HTTPS_PORT=443

# ---- secrets ----
SECRET_KEY=
ENCRYPTION_KEYS=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
METRICS_TOKEN=                       # Prometheus bearer token for api:8000/api/metrics and worker:9100/metrics

# ---- object storage ----
# Bundled SeaweedFS: the app's key below gets Read/Write/List on S3_BUCKET only. The admin key (bucket
# creation) is a Docker secret: put its secret in deploy/secrets/s3_admin_secret_access_key.
S3_BUCKET=resume-intelligence-private
S3_ACCESS_KEY_ID=ri-app
S3_SECRET_ACCESS_KEY=
S3_ADMIN_ACCESS_KEY_ID=ri-admin
S3_SSE=                              # SeaweedFS: empty. AWS S3: AES256 or aws:kms
# Managed S3 instead: S3_ENDPOINT_URL= (empty for AWS) plus S3_REGION, and remove the s3/s3-init services.

# ---- email (required) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# ---- AI ----
LLM_PROVIDER=disabled                # disabled | anthropic | openai (fixture is refused in production)
LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- staff ----
ADMIN_EMAILS=
RECRUITER_EMAILS=

# ---- observability ----
LOG_LEVEL=INFO
# SENTRY_DSN=

# ---- backups (service db-backup) ----
BACKUP_TIME=02:30                    # daily, UTC
BACKUP_KEEP_DAYS=14                  # dumps older than this are deleted after a successful backup
# Offsite copy (docker compose --profile offsite ...): a bucket in another account/region than this host.
# BACKUP_S3_URI=s3://my-ri-backups/postgres
# BACKUP_S3_ENDPOINT_URL=            # empty for AWS S3
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=us-east-1
# BACKUP_OFFSITE_INTERVAL=3600

# ---- build ----
INSTALL_ML=true                      # false: ~0.9 GB image with TF-IDF embeddings instead of Sentence Transformers
