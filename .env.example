# Copy to .env (repo root for docker compose, or backend/.env for running the API directly).
# Every external credential is optional: when absent, the app uses clearly labelled
# development fallbacks and shows "unavailable" states instead of fabricated data.

# ---- core ----
ENV=development                      # development | test | production (production enforces safe settings)
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Fernet key(s) for encryption at rest; newest first, comma separated, for rotation.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
COOKIE_SECURE=false                  # true behind HTTPS (required in production)
TRUSTED_PROXIES=0                    # number of reverse proxies that set X-Forwarded-For

# ---- data stores ----
DATABASE_URL=sqlite:///./dev.db      # postgresql+psycopg://user:pass@host:5432/db in compose/production
REDIS_URL=redis://localhost:6379/0
TASK_ALWAYS_EAGER=true               # false when running Celery workers
RATE_LIMIT_BACKEND=memory            # redis in multi-process deployments
POSTGRES_PASSWORD=ri-dev-password

# ---- storage ----
STORAGE_BACKEND=local                # local | s3
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=                     # empty for AWS S3; http://s3:8333 for the compose SeaweedFS store
S3_BUCKET=resume-intelligence-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256                        # server-side encryption header (in addition to app-level encryption)
SIGNED_URL_TTL_SECONDS=300

# ---- uploads & parsing ----
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=10
PARSE_SANDBOX=true
PARSE_TIMEOUT_SECONDS=45
PARSE_MEMORY_LIMIT_MB=768
OCR_ENABLED=false                    # requires tesseract + poppler (Docker build arg INSTALL_OCR=true)

# ---- quotas ----
UPLOADS_PER_DAY=20
AI_REQUESTS_PER_DAY=50
AI_MONTHLY_COST_LIMIT_USD=5.0
LOGIN_RATE_PER_MINUTE=10
API_RATE_PER_MINUTE=120

# ---- AI generation ----
# fixture = deterministic local stand-in, labelled "Development fixture" in the UI (not allowed in production)
# anthropic | openai = real providers (users must consent before resume text is sent)
# disabled = AI editing off; deterministic analysis still works
LLM_PROVIDER=fixture
LLM_MODEL=                           # the provider's model ID; required for anthropic / openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_INPUT_COST_PER_MTOK=3.0
LLM_OUTPUT_COST_PER_MTOK=15.0

# ---- embeddings ----
EMBEDDING_BACKEND=auto               # auto | sentence-transformers | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INSTALL_ML=true                      # docker build arg: bake Sentence Transformers into the image

# ---- integrations (absent => explicit "unavailable" state) ----
LEARNING_RESOURCES_PROVIDER=none     # none | curated_file
LEARNING_RESOURCES_FILE=
JOB_LISTINGS_PROVIDER=none

# ---- email ----
EMAIL_BACKEND=console                # console (dev) | smtp | memory (tests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- retention ----
FILE_RETENTION_DAYS=365
ANALYSIS_RETENTION_DAYS=365

# ---- observability ----
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
METRICS_ENABLED=true
METRICS_TOKEN=                       # set to require "Authorization: Bearer <token>" on /api/metrics

ADMIN_EMAILS=                        # comma separated; promoted to admin when they verify their email
RECRUITER_EMAILS=                    # comma separated; HR staff who post openings and review applicants
