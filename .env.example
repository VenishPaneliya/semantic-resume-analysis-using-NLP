# Copy to .env (repo root for docker compose, or backend/.env for running the API directly).
# Lists every setting in backend/app/config.py with its default from the code. Commented-out lines
# (# NAME=) are optional and unset by default; uncomment to set them.
# Every external credential is optional: when absent, the app uses clearly labelled development
# fallbacks and shows "unavailable" states instead of fabricated data.
# docker compose: every value here reaches api/worker/beat; docker-compose.yml overrides the ones it
# needs to wire the containers together (database, Redis, S3, SMTP, URLs).
# Production: start from deploy/env.production.example instead.

# ---- core ----
ENV=development                      # development | test | production (production refuses unsafe settings)
APP_NAME=Resume Intelligence         # shown in emails and page titles
PUBLIC_BASE_URL=http://localhost:3000   # the website's address; links in emails point here
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000   # comma separated

# ---- security ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me    # production: random, >= 32 chars
# Fernet key(s) for encryption at rest; newest first, comma separated, for rotation (required in production).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
ENCRYPTION_FALLBACK_SECRET_KEYS=   # earlier SECRET_KEY values, decryption only (see docs/OPERATIONS.md)
SESSION_COOKIE_NAME=ri_session
CSRF_COOKIE_NAME=ri_csrf
SESSION_TTL_HOURS=168                # 7 days
COOKIE_SECURE=false                  # true behind HTTPS (required in production)
# COOKIE_DOMAIN=                     # unset = host-only cookies (recommended)
TRUSTED_PROXIES=0                    # number of reverse proxies that set X-Forwarded-For

# ---- data stores ----
DATABASE_URL=sqlite:///./dev.db      # postgresql+psycopg://user:pass@host:5432/db in compose/production
REDIS_URL=redis://localhost:6379/0
TASK_ALWAYS_EAGER=true               # false when running Celery workers (required in production)
POSTGRES_PASSWORD=ri-dev-password    # docker compose only: the compose PostgreSQL password

# ---- storage ----
STORAGE_BACKEND=local                # local | s3 (s3 required in production)
LOCAL_STORAGE_PATH=./var/storage
# S3_ENDPOINT_URL=                   # unset for AWS S3; compose sets http://s3:8333 (SeaweedFS)
S3_BUCKET=resume-intelligence-private
S3_REGION=us-east-1
# The app's key. docker compose: defaults to a dev-only key with Read/Write/List on S3_BUCKET only.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# docker compose only: SeaweedFS admin key, used solely to create the bucket (never given to the app)
# S3_ADMIN_ACCESS_KEY_ID=
# S3_ADMIN_SECRET_ACCESS_KEY=
S3_SSE=AES256                        # server-side encryption header (in addition to app-level encryption); compose sets it empty
SIGNED_URL_TTL_SECONDS=300

# ---- uploads & parsing ----
MAX_UPLOAD_BYTES=5242880             # 5 MB
MAX_PDF_PAGES=10
MAX_DOCX_UNCOMPRESSED_BYTES=31457280 # 30 MB, zip-bomb guard
PARSE_SANDBOX=true                   # parse in a resource-limited child process
PARSE_TIMEOUT_SECONDS=45
PARSE_MEMORY_LIMIT_MB=768
OCR_ENABLED=false                    # requires tesseract + poppler (Docker build arg INSTALL_OCR=true)
# TESSERACT_CMD=                     # path to the tesseract binary when it is not on PATH

# ---- quotas & rate limits ----
RATE_LIMIT_BACKEND=memory            # memory | redis (redis required in production)
LOGIN_RATE_PER_MINUTE=10             # per client IP
LOGIN_FAILURES_PER_ACCOUNT=10        # wrong passwords per account per 15 min, whatever the client IP
SECOND_FACTOR_FAILURES_PER_ACCOUNT=10  # wrong 2FA codes per account per hour
API_RATE_PER_MINUTE=120
UPLOADS_PER_DAY=20
AI_REQUESTS_PER_DAY=50
AI_MONTHLY_COST_LIMIT_USD=5.0

# ---- AI generation ----
# fixture = deterministic local stand-in, labelled "Development fixture" in the UI (not allowed in production)
# anthropic | openai = real providers (users must consent before resume text is sent)
# disabled = AI editing off; deterministic analysis still works
LLM_PROVIDER=fixture
LLM_MODEL=                           # the provider's model ID; required for anthropic / openai
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_INPUT_COST_PER_MTOK=3.0          # USD per 1M tokens, for usage accounting (set to your contract)
LLM_OUTPUT_COST_PER_MTOK=15.0

# ---- embeddings ----
EMBEDDING_BACKEND=auto               # auto | sentence-transformers | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INSTALL_ML=true                      # docker build arg: bake Sentence Transformers into the image

# ---- integrations (absent => explicit "unavailable" state) ----
LEARNING_RESOURCES_PROVIDER=curated_file   # curated_file (bundled, link-checked official docs) | none
# LEARNING_RESOURCES_FILE=           # unset = the bundled list; or a path to your own JSON list
JOB_LISTINGS_PROVIDER=none           # none (no listings provider is implemented yet)

# ---- email ----
EMAIL_BACKEND=console                # console (dev) | smtp (required in production) | memory (tests)
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_STARTTLS=true

# ---- Google OAuth (optional; the button is hidden without both) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- retention ----
FILE_RETENTION_DAYS=365
ANALYSIS_RETENTION_DAYS=365
UNVERIFIED_ACCOUNT_RETENTION_DAYS=30
BULK_UPLOAD_RETENTION_DAYS=90        # recruiter-uploaded candidates are deleted after this many days
BULK_UPLOAD_MAX_FILES=25
BULK_UPLOAD_TIME_BUDGET_SECONDS=120  # files not parsed within this time are reported as "upload again"
PROCESSING_JOB_RETENTION_DAYS=30     # finished job rows are purged after this

# ---- observability ----
LOG_LEVEL=INFO
LOG_JSON=true
# SENTRY_DSN=
METRICS_ENABLED=true
# Required in production when metrics are enabled. Scrape the API container directly
# (api:8000/api/metrics); the website does not forward /api/metrics.
METRICS_TOKEN=
WORKER_METRICS_PORT=0                # Celery worker serves /metrics here (same token); compose sets 9100

# ---- staff ----
ADMIN_EMAILS=                        # comma separated; promoted to admin when they verify their email
RECRUITER_EMAILS=                    # comma separated; HR staff who post openings and review applicants
REQUIRE_MFA_FOR_STAFF=true           # recruiters/admins must turn on two-factor login (required in production)

# ---- docker compose host ports (127.0.0.1 only) ----
# FRONTEND_HOST_PORT=3000
# API_HOST_PORT=8000
# MAILPIT_HOST_PORT=8025
